subscription_id    = "00000000-0000-0000-0000-000000000000"
resource_group_name = "rg-checkpoint-byol-demo"
prefix              = "cpbyol"
company_domain      = "example.org"

location        = "westeurope"
remote_location = "northeurope"

# Required. Used for the built-in Gaia admin account in the serial console and
# Gaia CLI/Portal. SSH continues to use the generated or supplied public key.
checkpoint_admin_password = "REPLACE_ME"

# Optional additional private/VPN administrator networks. The management subnet
# below is always included, and no management service is exposed on Public IP.
# management_cidrs = [
#   "10.70.0.0/24",
# ]

checkpoint_os_version = "R82"
# Optional: use a generalized managed image or Compute Gallery image instead
# of the Marketplace image. Keep true for Marketplace-derived images. Set false
# only for the Check Point-authorized R81 image that has no Marketplace plan.
# checkpoint_image_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-image-rg/providers/Microsoft.Compute/galleries/example-gallery/images/checkpoint-r82-byol/versions/1.0.0"
# checkpoint_image_requires_plan = true
# For a planless R81 custom image, also set checkpoint_os_version = "R81"
# and enable_tls_inspection = false.
# After completing the documented R81 SmartConsole HTTPS bootstrap, use:
# enable_tls_inspection       = true
# r81_tls_manually_configured = true
# and export CHECKPOINT_TLS_CA_FILE=/path/to/public-outbound-ca.cer.

# Check Point mgmt-byol is Gen1, while Dv6 is Gen2-only.
checkpoint_vm_size = "Standard_D8s_v5" # 8 vCPU / 32 GiB
workload_vm_size   = "Standard_D4ls_v6" # 4 vCPU / 8 GiB
collector_vm_size  = "Standard_D4ls_v6" # 4 vCPU / 8 GiB

# Private Windows Server client and Basic Azure Bastion for future SmartConsole.
# Leave the password unset to generate it in Terraform state, then retrieve it
# with: terraform -chdir=infra output -raw windows_client_admin_password
enable_management_workstation = true
windows_client_vm_size        = "Standard_D4ls_v6" # 4 vCPU / 8 GiB
management_subnet_prefix      = "10.60.3.0/24"

# Customer-approved policy examples. Names must match Check Point's English
# Updatable Object and Application Control catalogs.
blocked_countries    = ["China"]
blocked_applications = ["P2P File Sharing"]
blocked_urls         = ["example.com", "httpbin.org/anything/blocked"]

# deploy.sh never configures Gaia routes, Log Exporter, objects, rules, or policy.
# These flags apply only if configure-policy.sh is run later from the private
# management network.
skip_policy_configuration = true
# Used only when skip_policy_configuration = false.
enable_tls_inspection = false

# Disabled by default to avoid exposing a service. When enabled, use a
# restricted source CIDR; Terraform rejects 0.0.0.0/0.
enable_inbound_demo      = false
inbound_demo_source_cidr = ""

log_analytics_retention_days = 90
immutable_retention_days     = 365

tags = {
  owner       = "network-security"
  environment = "demo"
}
