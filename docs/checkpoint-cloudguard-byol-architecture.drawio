  <diagram id="policy-tls" name="03-安全策略与TLS">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="p0"/>
        <mxCell id="p1" parent="p0"/>
        <mxCell id="p-title" value="Check Point 手工策略规划与保留的 R81 / R82 自动化" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="p1">
          <mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p-objects" value="策略对象" style="swimlane;horizontal=1;startSize=34;rounded=1;whiteSpace=wrap;html=1;strokeColor=#2684FF;fillColor=#F7FBFF;fontStyle=1;fontSize=14;fontColor=#0747A6;" vertex="1" parent="p1">
          <mxGeometry x="45" y="100" width="390" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="p-networks" value="Network Group: CloudGuard-Protected-Networks&#xa;• CloudGuard-EU-Spoke 10.61.0.0/16&#xa;• CloudGuard-Remote-Spoke 10.62.0.0/16&#xa;eth2: network defined by routing" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2684FF;fillColor=#DEEBFF;fontSize=12;fontColor=#0747A6;" vertex="1" parent="p1">
          <mxGeometry x="80" y="165" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p-geo" value="Geo Updatable Objects&#xa;运行时按英文国家名精确查询 repository&#xa;导入 UID/URI，不使用静态 CIDR 回退" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#DE350B;fillColor=#FFEBE6;fontSize=12;fontColor=#BF2600;" vertex="1" parent="p1">
          <mxGeometry x="80" y="295" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p-l7" value="Application / Site Objects&#xa;• Custom URL list&#xa;• example.com&#xa;• httpbin.org/anything/blocked&#xa;• P2P File Sharing category" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6554C0;fillColor=#EAE6FF;fontSize=12;fontColor=#403294;" vertex="1" parent="p1">
          <mxGeometry x="80" y="425" width="320" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="p-services" value="Service / Host Objects&#xa;• TCP/8080 demo web&#xa;• TCP/18080 optional ingress&#xa;• Frontend eth1 host 10.60.0.4&#xa;• EU web host 10.61.0.4" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#36B37E;fillColor=#E3FCEF;fontSize=12;fontColor=#006644;" vertex="1" parent="p1">
          <mxGeometry x="80" y="580" width="320" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="p-target" value="Policy Target&#xa;Current: standalone via management 10.60.3.4&#xa;Future: dedicated Management Server + multiple Gateways" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FF8B00;fillColor=#FFF0B3;fontSize=12;fontColor=#974F0C;" vertex="1" parent="p1">
          <mxGeometry x="80" y="735" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p-policy" value="SmartConsole 手工配置顺序（可选内网脚本保留）" style="swimlane;horizontal=1;startSize=34;rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#FF5630;fillColor=#FFF7F5;fontStyle=1;fontSize=14;fontColor=#BF2600;" vertex="1" parent="p1">
          <mxGeometry x="475" y="100" width="520" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="p-r1" value="1. Confirm eth0/eth1/eth2 topology&#xa;2. Allow private management sources&#xa;Management traffic never enters public frontend" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#36B37E;fillColor=#E3FCEF;fontStyle=1;fontSize=12;fontColor=#006644;" vertex="1" parent="p1">
          <mxGeometry x="525" y="155" width="420" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="p-r2" value="3. Block Geo Inbound&#xa;4. Block Geo Outbound&#xa;Geo UID | Drop | Extended Log" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#DE350B;fillColor=#FFEBE6;fontStyle=1;fontSize=12;fontColor=#BF2600;" vertex="1" parent="p1">
          <mxGeometry x="525" y="240" width="420" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="p-r3" value="5. Block Domains / URLs / Applications&#xa;Application Control + URL Filtering | Drop | Extended Log" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#DE350B;fillColor=#FFEBE6;fontStyle=1;fontSize=12;fontColor=#BF2600;" vertex="1" parent="p1">
          <mxGeometry x="525" y="325" width="420" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="p-r4" value="6. Optional Restricted North-South Inbound&#xa;Approved source → frontend TCP/18080 | Accept + DNAT" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FF8B00;fillColor=#FFF0B3;fontStyle=1;fontSize=12;fontColor=#974F0C;" vertex="1" parent="p1">
          <mxGeometry x="525" y="410" width="420" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="p-r5" value="7. Allow Inspected East-West Web&#xa;Protected group ↔ protected group | TCP/8080 | Extended Log" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#36B37E;fillColor=#E3FCEF;fontStyle=1;fontSize=12;fontColor=#006644;" vertex="1" parent="p1">
          <mxGeometry x="525" y="495" width="420" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="p-r6" value="8. Allow Web and DNS Egress&#xa;HTTP / HTTPS / domain-udp / domain-tcp | Extended Log" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#36B37E;fillColor=#E3FCEF;fontStyle=1;fontSize=12;fontColor=#006644;" vertex="1" parent="p1">
          <mxGeometry x="525" y="580" width="420" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="p-r7" value="9. Cleanup Drop&#xa;Any / Any / Any | Drop | Log" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#DE350B;fillColor=#FFEBE6;fontStyle=1;fontSize=12;fontColor=#BF2600;" vertex="1" parent="p1">
          <mxGeometry x="525" y="665" width="420" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p-install" value="Publish Session → install-policy&#xa;Access = true | Threat Prevention = false" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#FF5630;fillColor=#FFEBE6;fontStyle=1;fontSize=12;fontColor=#BF2600;" vertex="1" parent="p1">
          <mxGeometry x="525" y="760" width="420" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="p-tls-zone" value="HTTPS Inspection 与证书信任" style="swimlane;horizontal=1;startSize=34;rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#6554C0;fillColor=#FAF8FF;fontStyle=1;fontSize=14;fontColor=#403294;" vertex="1" parent="p1">
          <mxGeometry x="1035" y="100" width="520" height="760" as="geometry"/>
        </mxCell>
        <mxCell id="p-ca" value="Outbound Inspection Certificate&#xa;Name: CloudGuardDemoOutboundCA&#xa;issued-by: company_domain&#xa;Private key remains on Management" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#6554C0;fillColor=#EAE6FF;fontStyle=1;fontSize=12;fontColor=#403294;" vertex="1" parent="p1">
          <mxGeometry x="1100" y="175" width="390" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p-https-layer" value="Outbound HTTPS Layer&#xa;Source: protected networks&#xa;Destination: Internet&#xa;Service: HTTPS default services&#xa;Blades: Application Control + URL Filtering&#xa;Action: Inspect | Track: Log" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#6554C0;fillColor=#EAE6FF;fontStyle=1;fontSize=12;fontColor=#403294;" vertex="1" parent="p1">
          <mxGeometry x="1100" y="305" width="390" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p-public-ca" value="Public CA only&#xa;Exported in SmartConsole or optional internal script&#xa;Saved as .local/checkpoint-demo-ca.pem" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6554C0;fillColor=#EAE6FF;fontSize=12;fontColor=#403294;" vertex="1" parent="p1">
          <mxGeometry x="1100" y="500" width="390" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p-trust" value="Trust Distribution&#xa;Manual baseline or optional internal automation&#xa;Independent tests verify the leaf issuer" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#36B37E;fillColor=#E3FCEF;fontStyle=1;fontSize=12;fontColor=#006644;" vertex="1" parent="p1">
          <mxGeometry x="1100" y="630" width="390" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p-prod" value="生产必须替换：企业 Inspection CA、密钥生命周期、金融/医疗/隐私 bypass、证书固定应用、QUIC/HTTP3 策略和法律评审。" style="shape=note;whiteSpace=wrap;html=1;strokeColor=#FF8B00;fillColor=#FFF0B3;fontSize=11;fontColor=#974F0C;" vertex="1" parent="p1">
          <mxGeometry x="1080" y="755" width="430" height="80" as="geometry"/>
