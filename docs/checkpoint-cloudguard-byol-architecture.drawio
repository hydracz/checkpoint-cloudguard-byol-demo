        <mxCell id="d-s3" value="3. Terraform Infrastructure&#xa;VNet / 3-NIC Gateway / Windows / Bastion&#xa;AMA-DCR / LAW / Storage" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#2684FF;fillColor=#DEEBFF;fontStyle=1;fontSize=11;fontColor=#0747A6;" vertex="1" parent="d1"><mxGeometry x="460" y="165" width="210" height="105" as="geometry"/></mxCell>
