        <mxCell id="d-s5" value="Optional Audit Export&#xa;enable-audit-export.sh&#xa;Bootstrap Syslog + Data Export" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#6554C0;fillColor=#EAE6FF;fontStyle=1;fontSize=11;fontColor=#403294;" vertex="1" parent="d1"><mxGeometry x="930" y="170" width="190" height="95" as="geometry"/></mxCell>
