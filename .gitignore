# Deployment secrets and the repository-local SSH key must never be committed.
.local/
/.local/checkpoint-demo-ssh
/.local/checkpoint-demo-ssh.pub
evidence/
.terraform/
infra/.terraform/
infra/*.auto.tfvars.json
configs/*.tfvars
!configs/*.tfvars.example
*.tfstate
*.tfstate.*
*.tfplan
*.pem
*.p12
*.key

# Private VM image archives, manifests, and runbooks must never be committed.
*.vhd
*.vhd.*
*.vhdx
*.vhdx.*
/cloudguard-images/
